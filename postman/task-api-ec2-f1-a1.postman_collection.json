{
  "info": {
    "name": "Task API EC2 F1 A1",
    "description": "Colección de pruebas para MongoDB Atlas y diagnóstico de disponibilidad (EC2 F1 A5) - Express & Mongoose",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "1. Positiva: Health (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contiene status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
              "pm.test(\"Incluye encabezado X-Request-Id\", () => pm.expect(pm.response.headers.has(\"X-Request-Id\")).to.be.true);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "2. Positiva: Health Database (200 connected)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Database status es connected\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.database.status).to.eql(\"connected\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/database"
      }
    },
    {
      "name": "3. Regresión: Listar tareas (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve arreglo de tareas\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "4. Regresión: Crear tarea (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json.data && json.data.id) {",
              "    pm.collectionVariables.set(\"taskId\", json.data.id.toString());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Preparar persistencia\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "5. Regresión: Consultar tarea por ID (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Título coincide\", () => pm.expect(pm.response.json().data.title).to.eql(\"Preparar persistencia\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "6. Negativa: ID no numérico (400 INVALID_ID)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Code es INVALID_ID\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_ID\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/abc"
      }
    },
    {
      "name": "7. Negativa: Tarea inexistente (404 TASK_NOT_FOUND)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Code es TASK_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"TASK_NOT_FOUND\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/999"
      }
    },
    {
      "name": "8. Negativa: Content-Type no soportado (415 UNSUPPORTED_MEDIA_TYPE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 415\", () => pm.response.to.have.status(415));",
              "pm.test(\"Code es UNSUPPORTED_MEDIA_TYPE\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNSUPPORTED_MEDIA_TYPE\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "Texto plano sin JSON"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "9. Negativa: Título vacío (422 VALIDATION_ERROR)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Code es VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "10. Negativa: Ruta inexistente (404 ROUTE_NOT_FOUND)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Code es ROUTE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"ROUTE_NOT_FOUND\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ruta-inexistente"
      }
    },
    {
      "name": "11. Regresión: Completar tarea (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Estado es completed\", () => pm.expect(pm.response.json().data.status).to.eql(\"completed\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
      }
    },
    {
      "name": "12. Regresión: Eliminar tarea (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 204\", () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    },
    {
      "name": "13. Regresión: Comprobar eliminada (404 TASK_NOT_FOUND)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Code es TASK_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"TASK_NOT_FOUND\"));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      }
    }
  ]
}