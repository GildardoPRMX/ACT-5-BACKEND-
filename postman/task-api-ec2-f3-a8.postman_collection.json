    {
      "name": "04. Listado predeterminado sin parámetros",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "pm.test('data es arreglo', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('meta existe y contiene paginacion', () => {",
              "  pm.expect(body.meta).to.be.an('object');",
              "  pm.expect(body.meta.page).to.eql(1);",
              "  pm.expect(body.meta.limit).to.eql(10);",
              "  pm.expect(body.meta.total).to.be.a('number');",
              "  pm.expect(body.meta.totalPages).to.be.a('number');",
              "});",
              "pm.test('no expone _id ni __v', () => {",
              "  if (body.data.length > 0) {",
              "    pm.expect(body.data[0]._id).to.be.undefined;",
              "    pm.expect(body.data[0].__v).to.be.undefined;",
              "    pm.expect(body.data[0].id).to.be.a('string');",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks"
